#!/usr/bin/env python
# coding: utf-8

# # Import software libraries

# In[1]:


# Import required libraries.
import sys           # Read system parameters.
import pandas as pd  # Manipulate and analyze data.
import sqlite3       # Manage SQL databases.

# Summarize software libraries used.
print('Libraries used in this project:')
print('- Python {}'.format(sys.version))
print('- pandas {}'.format(pd.__version__))
print('- sqlite3 {}'.format(sqlite3.sqlite_version))


# # Examine the database

# In[3]:


# Connect to SQLite database.

conn = sqlite3.connect('database.db')
cursor = conn.cursor()


# In[ ]:


# List all the tables in the database.


cursor.execute("SELECT name FROM sqlite_master WHERE type='table';")
tables = cursor.fetchall()
print("Tables in the database:", tables)


# # Read data from the `online_retail_history` table

# In[ ]:


# Write the query to be executed that selects everything from the online_retail_history table.

query = "SELECT * FROM online_retail_history"


# Use the read_sql function in pandas to read a query into a DataFrame.

online_retail_history = pd.read_sql(query, conn)

# Preview the first five rows of the data.

print("\nFirst 5 rows of online_retail_history:")
print(online_retail_history.head().to_markdown(index=False, numalign="left", stralign="left"))


# In[ ]:


# Get the shape of the data.

print("\nShape of online_retail_history:", online_retail_history.shape)


# # Read data from the `stock_description` table

# In[ ]:


# Write the query to be executed that selects everything from the online_retail_history table.


query = "SELECT * FROM stock_description"


# Use the read_sql function in pandas to read a query into a DataFrame.
stock_description = pd.read_sql(query, conn)



# Preview the first five rows of the data.
print("\nFirst 5 rows of stock_description:")
print(stock_description.head().to_markdown(index=False, numalign="left", stralign="left"))


# In[ ]:


# Get the shape of the data.

print("\nShape of stock_description:", stock_description.shape)


# # Aggregate the `online_retail_history` and `stock_description` datasets

# In[ ]:


# Write a query to aggregate the two datasets so that you have the stock descriptions as well as the stock code.
query = """
SELECT 
    o.*, 
    s.Description 
FROM 
    online_retail_history o
LEFT JOIN 
    stock_description s 
ON 
    o.StockCode = s.StockCode
"""


# Use the read_sql function in pandas to read a query into a DataFrame.

aggregated_data = pd.read_sql(query, conn)


# Preview the first five rows of the data.

print("\nFirst 5 rows of aggregated_data:")
print(aggregated_data.head().to_markdown(index=False, numalign="left", stralign="left"))


# In[ ]:


# Get the shape of the data.

print("\nShape of aggregated_data:", aggregated_data.shape)


# # Identify and fix corrupt or unusable data

# In[ ]:


# Check the value counts of the "Description" field.

print("\nValue counts of 'Description' before cleaning:")
print(aggregated_data['Description'].value_counts().head().to_markdown(numalign="left", stralign="left"))


# In[ ]:


# Remove rows where "Description" is just a question mark (?).

aggregated_data = aggregated_data[aggregated_data['Description'] != '?']






# Preview the first five rows of the data.
print("\nFirst 5 rows of aggregated_data after removing '?' in 'Description':")
print(aggregated_data.head().to_markdown(index=False, numalign="left", stralign="left"))


# # Identify and remove duplicates

# In[ ]:


# Identify all duplicated data.


duplicates = aggregated_data[aggregated_data.duplicated()]


# In[ ]:


# Print the duplicated data.
print("\nDuplicated data:")
print(duplicates.head().to_markdown(index=False, numalign="left", stralign="left"))


# In[ ]:


# Remove the duplicated data.

aggregated_data.drop_duplicates(inplace=True)






# Preview the first five rows of the data.

print("\nFirst 5 rows of aggregated_data after removing duplicates:")
print(aggregated_data.head().to_markdown(index=False, numalign="left", stralign="left"))


# # Correct date formats

# In[ ]:


# Get the data types for every column in the DataFrame.

print("\nData types before conversion:")
print(aggregated_data.dtypes.to_markdown(numalign="left", stralign="left"))


# In[ ]:


# Convert "InvoiceDate" to a "%Y-%m-%d" datetime format.

aggregated_data['InvoiceDate'] = pd.to_datetime(aggregated_data['InvoiceDate'], format="%Y-%m-%d")


# In[ ]:


# Get the data types for every column in the converted DataFrame.

print("\nData types after conversion:")
print(aggregated_data.dtypes.to_markdown(numalign="left", stralign="left"))


# # Examine the table before finishing

# In[ ]:


# Preview the first five rows of the data.

print("\nFirst 5 rows of aggregated_data after datetime conversion:")
print(aggregated_data.head().to_markdown(index=False, numalign="left", stralign="left"))


# # Load the dataset into a pickle file

# In[ ]:


# Save the dataset as a pickle file named online_history_cleaned.pickle.

aggregated_data.to_pickle('online_history_cleaned.pickle')


# In[ ]:


# Close any connections to the database.

conn.close()

